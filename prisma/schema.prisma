generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model attachments {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id String                @db.Uuid
  customer_id String?               @db.Uuid
  booking_id  String?               @db.Uuid
  enquiry_id  String?               @db.Uuid
  file_url    String
  file_name   String                @db.VarChar(255)
  mime_type   String?               @db.VarChar(120)
  visibility  attachment_visibility @default(PRIVATE)
  uploaded_by String?               @db.Uuid
  created_at  DateTime              @default(now()) @db.Timestamptz(6)
  bookings    bookings?             @relation(fields: [booking_id], references: [id], onUpdate: NoAction)
  businesses  businesses            @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customers   customers?            @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  enquiries   enquiries?            @relation(fields: [enquiry_id], references: [id], onUpdate: NoAction)
  users       users?                @relation(fields: [uploaded_by], references: [id], onUpdate: NoAction)

  @@index([business_id, customer_id], map: "idx_attachments_customer")
}

model audit_logs {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id   String?     @db.Uuid
  actor_user_id String?     @db.Uuid
  action        String      @db.VarChar(100)
  entity_type   String      @db.VarChar(100)
  entity_id     String?     @db.Uuid
  details       Json        @default("{}")
  ip_address    String?     @db.Inet
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  users         users?      @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction)
  businesses    businesses? @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([business_id, entity_type, entity_id, created_at(sort: Desc)], map: "idx_audit_logs_entity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model booking_events {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id      String     @db.Uuid
  booking_id       String     @db.Uuid
  event_kind       event_type @default(WEDDING)
  title            String     @db.VarChar(180)
  event_date       DateTime   @db.Date
  start_time       DateTime?  @db.Time(6)
  end_time         DateTime?  @db.Time(6)
  venue            String?
  city             String?    @db.VarChar(100)
  latitude         Decimal?   @db.Decimal(10, 7)
  longitude        Decimal?   @db.Decimal(10, 7)
  assigned_user_id String?    @db.Uuid
  status           String     @default("SCHEDULED") @db.VarChar(40)
  instructions     String?
  created_at       DateTime   @default(now()) @db.Timestamptz(6)
  updated_at       DateTime   @default(now()) @db.Timestamptz(6)
  users            users?     @relation(fields: [assigned_user_id], references: [id], onUpdate: NoAction)
  bookings         bookings   @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  businesses       businesses @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([business_id, event_date], map: "idx_booking_events_date")
}

model booking_status_history {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id String          @db.Uuid
  booking_id  String          @db.Uuid
  old_status  booking_status?
  new_status  booking_status
  note        String?
  changed_by  String?         @db.Uuid
  changed_at  DateTime        @default(now()) @db.Timestamptz(6)
  bookings    bookings        @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  businesses  businesses      @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users?          @relation(fields: [changed_by], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bookings {
  id                                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id                              String                   @db.Uuid
  customer_id                              String                   @db.Uuid
  enquiry_id                               String?                  @db.Uuid
  quotation_id                             String?                  @db.Uuid
  booking_number                           String                   @db.VarChar(60)
  status                                   booking_status           @default(CONFIRMED)
  package_id                               String?                  @db.Uuid
  package_name_snapshot                    String?                  @db.VarChar(180)
  total_amount_paise                       BigInt                   @default(0)
  discount_paise                           BigInt                   @default(0)
  notes                                    String?
  cancellation_reason                      String?
  created_by                               String?                  @db.Uuid
  created_at                               DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                               DateTime                 @default(now()) @db.Timestamptz(6)
  approved_refundable_paise                BigInt                   @default(0)
  refund_approval_notes                    String?
  refund_approved_by                       String?                  @db.Uuid
  refund_approved_at                       DateTime?                @db.Timestamptz(6)
  attachments                              attachments[]
  booking_events                           booking_events[]
  booking_status_history                   booking_status_history[]
  businesses                               businesses               @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                                    users?                   @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  customers                                customers                @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  enquiries                                enquiries?               @relation(fields: [enquiry_id], references: [id], onUpdate: NoAction)
  packages                                 packages?                @relation(fields: [package_id], references: [id], onUpdate: NoAction)
  quotations                               quotations?              @relation(fields: [quotation_id], references: [id], onUpdate: NoAction)
  users_bookings_refund_approved_byTousers users?                   @relation("bookings_refund_approved_byTousers", fields: [refund_approved_by], references: [id], onUpdate: NoAction)
  consultations                            consultations[]
  notification_jobs                        notification_jobs[]
  payment_records                          payment_records[]
  stock_movements                          stock_movements[]

  @@unique([business_id, booking_number])
  @@index([business_id, status], map: "idx_bookings_business_status")
  @@index([business_id, customer_id], map: "idx_bookings_customer")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model business_entitlements {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id        String              @unique @db.Uuid
  plan_id            String              @db.Uuid
  status             subscription_status @default(ACTIVE)
  starts_at          DateTime            @default(now()) @db.Timestamptz(6)
  ends_at            DateTime?           @db.Timestamptz(6)
  auto_renew         Boolean             @default(false)
  purchase_reference String?             @db.VarChar(160)
  notes              String?
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime            @default(now()) @db.Timestamptz(6)
  businesses         businesses          @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  plans              plans               @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model business_members {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id String     @db.Uuid
  user_id     String     @db.Uuid
  role        user_role  @default(OWNER)
  is_active   Boolean    @default(true)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  businesses  businesses @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([business_id, user_id])
  @@index([user_id], map: "idx_business_members_user")
}

