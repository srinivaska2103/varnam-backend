  consultations         consultations @relation(fields: [consultation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customers             customers?    @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  enquiries             enquiries?    @relation(fields: [enquiry_id], references: [id], onUpdate: NoAction)
  users                 users?        @relation(fields: [recorded_by], references: [id], onUpdate: NoAction)

  @@index([business_id, consultation_id], map: "idx_consultation_outcomes_consultation")
  @@index([business_id, outcome_tag], map: "idx_consultation_outcomes_tag")
  @@index([business_id, follow_up_date], map: "idx_consultation_outcomes_followup")
  @@index([business_id, created_at(sort: Desc)], map: "idx_consultation_outcomes_created")
