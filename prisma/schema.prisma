  contact_phone   String?        @db.VarChar(30)
  whatsapp_phone  String?        @db.VarChar(30)
  public_address  String?
  map_url         String?
  primary_color   String?        @db.VarChar(7)
  logo_url        String?
  seo_title       String?        @db.VarChar(180)
  seo_description String?        @db.VarChar(320)
  published_at    DateTime?      @db.Timestamptz(6)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime       @default(now()) @db.Timestamptz(6)
  businesses      businesses     @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

